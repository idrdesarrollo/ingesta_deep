# Copiar a .env y rellenar. .env NO se commitea (está en .gitignore).

# PostgreSQL (keywords/db.py)
DB_NAME=oceano_azul
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Scripts de backfill (scripts/*.py) usan un DSN completo
OCEANO_DSN=dbname=oceano_azul user=postgres password= host=localhost port=5432

# Embeddings
BGE_MODEL=BAAI/bge-m3
# HF_TOKEN=            # opcional: token de HuggingFace para la descarga del modelo
